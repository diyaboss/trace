# Set environment variables explicitly; this file is not automatically loaded.
# XE 11g SID syntax; no PDB exists in this installation.
TRACE_DB_URL=jdbc:oracle:thin:@localhost:1521:XE
TRACE_DB_USER=TRACE_APP
TRACE_DB_PASSWORD=replace_locally
TRACE_PORT=7000
# Relative to backend working directory, or use an absolute directory.
TRACE_FRONTEND_DIST=../frontend/dist
# Dedicated test schema. NEVER point tests at the application schema.
TRACE_TEST_DB_URL=jdbc:oracle:thin:@localhost:1521:XE
TRACE_TEST_DB_USER=TRACE_TEST
TRACE_TEST_DB_PASSWORD=replace_locally
